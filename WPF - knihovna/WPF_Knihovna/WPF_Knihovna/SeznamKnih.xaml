<UserControl x:Class="WPF_Knihovna.SeznamKnih"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_Knihovna"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid x:Name="RootGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="Hledat:" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Width="200" Margin="5,0,0,0" 
                 TextChanged="SearchBox_TextChanged"/>

            <TextBlock Text="Stav:" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="StavComboBox" Width="120" Margin="5,0,0,0"
                  SelectionChanged="StavComboBox_SelectionChanged">
                <ComboBoxItem Content="-" IsSelected="True"/>
                <ComboBoxItem Content="Přečteno"/>
                <ComboBoxItem Content="Nepřečteno"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="KnihyGrid"
          Grid.Row="1"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          Margin="10"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          ColumnWidth="*">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Název" Binding="{Binding Nazev}" Width="*" MinWidth="100"/>
                <DataGridTextColumn Header="Autor" Binding="{Binding Autor}" Width="*" MinWidth="100"/>
                <DataGridTextColumn Header="Rok vydání" Binding="{Binding RokVydani}" Width="80" MinWidth="60"/>
                <DataGridTextColumn Header="Žánr" Binding="{Binding Zanr}" Width="*" MinWidth="80"/>
                <DataGridTextColumn Header="Stav" Binding="{Binding Stav}" Width="100" MinWidth="80"/>
                <DataGridTextColumn Header="Hodnocení" Binding="{Binding Hodnoceni}" Width="80" MinWidth="50"/>

                <DataGridTemplateColumn Header="Upravit" Width="80" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Upravit"
                            Click="Upravit_Click"
                            Tag="{Binding Id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Odstranit" Width="80" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Odstranit"
                            Click="Odstranit_Click"
                            Tag="{Binding Id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
    
</UserControl>
